{
  "setupFilesAfterEnv": ["./jest.setup.js"],
  "clearMocks": true,
  "restoreMocks": true,
  "resetMocks": true,
  "globals": {
    "server": null
  },
  "moduleNameMapper": {
    "@root(.*)$": "<rootDir>/$1",
    "@(routes|daos|services|analytics)(.*)$": "<rootDir>/lib/$1/$2",
    "@(utils|config|plugins)(.*)$": "<rootDir>/$1/$2"
  },
  "coverageReporters": ["json-summary", "text", "lcov"],
  "coverageThreshold": {
    "global": {
      "statements": 85,
      "branches": 65,
      "functions": 75,
      "lines": 85
    }
  },
  "testTimeout": 20000,
  "coveragePathIgnorePatterns": [
    "<rootDir>/node_modules/",
    "<rootDir>/lib/testServer.js"
  ]
}
